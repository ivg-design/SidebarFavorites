              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "On load the Finder mock’s grey folders morph into their glyphs one row at a time, 60 ms stagger, ease-out-quint 480 ms. Headline words rise 12 px + fade with the same stagger. Reduced-motion: static final state.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 12
            }
          ]
        },
        {
          "type": "frame",
